# Copy values into Railway → n8n service → Variables.
# Do not commit real secrets. Do not put OpenRouter / Notion / Google keys here
# unless you deliberately want them as env vars; this setup stores those in the
# n8n Credentials UI after the instance is up.

# --- Required before the first deploy ---
# openssl rand -hex 32
# Set once. Never rotate it or stored credentials become unreadable.
N8N_ENCRYPTION_KEY=

# Railway injects PORT. Bind n8n to it.
N8N_PORT=${{PORT}}
N8N_PROTOCOL=https

# After you generate a public domain, set these to that host (no trailing path).
# Example: n8n-production-xxxx.up.railway.app
N8N_HOST=
WEBHOOK_URL=https://REPLACE_ME.up.railway.app/

GENERIC_TIMEZONE=Europe/Zurich
N8N_DEFAULT_BINARY_DATA_MODE=filesystem
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
N8N_SECURE_COOKIE=true
N8N_PROXY_HOPS=1

# Optional: first-user owner account is created in the n8n UI on first visit.
# Keep the Railway URL private. If you still want HTTP basic auth on older images:
# N8N_BASIC_AUTH_ACTIVE=true
# N8N_BASIC_AUTH_USER=
# N8N_BASIC_AUTH_PASSWORD=

# Optional production database (recommended once the instance is stable).
# DB_TYPE=postgresdb
# DB_POSTGRESDB_HOST=${{Postgres.PGHOST}}
# DB_POSTGRESDB_PORT=${{Postgres.PGPORT}}
# DB_POSTGRESDB_DATABASE=${{Postgres.PGDATABASE}}
# DB_POSTGRESDB_USER=${{Postgres.PGUSER}}
# DB_POSTGRESDB_PASSWORD=${{Postgres.PGPASSWORD}}
